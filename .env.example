# Placeholders only. Real values come from your secret store, never from this repository.
# The password of the database role goes in PGPASSWORD (or a .pgpass file), not in the URL.
DATABASE_URL=postgres://marketplace_app@db.internal:5432/marketplace
DATABASE_ADMIN_URL=postgres://schema_owner@db.internal:5432/marketplace
PGPASSWORD=
# the platform's secret (or restricted) API key
STRIPE_SECRET_KEY=
# the signing secrets of the webhook endpoints, newest first, comma separated: Stripe gives the account endpoint and the Connect endpoint a secret each
WEBHOOK_SECRETS=
# the one origin people are sent back to after onboarding and checkout (https; plain http only for localhost)
APP_ORIGIN=https://marketplace.example
# the platform's commission: percent in basis points (1000 = 10 %), a fixed amount and the smallest charge, all in minor units
FEE_PERCENT_BPS=1000
FEE_FIXED_MINOR=30
MIN_CHARGE_MINOR=100
# optional: pin the Stripe API version the adapter sends
STRIPE_API_VERSION=
HOST=127.0.0.1
PORT=8080
WEBHOOK_MAX_BODY_BYTES=65536
WEBHOOK_TOLERANCE_SECONDS=300
TRUSTED_PROXY_HOPS=0
# how far back `reconcile` compares, in days
SINCE_DAYS=30
